{
  "root": true,
  "env": {
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["standard", "plugin:prettier/recommended"],
  "plugins": ["prettier"],
  "rules": {
    "no-unused-vars": [
      "error",
      { "args": "after-used", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-var": "error",
    "prefer-const": ["error", { "destructuring": "all" }],
    "prettier/prettier": "error"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**/*.js", "src/test/**/*.js"],
      "env": { "jest": true }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", "server.js"]
}
