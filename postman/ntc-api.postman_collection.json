{
  "info": {
    "name": "National Transit Connect API",
    "description": "Starter collection for health checks, authentication, CRUD resources, and SSE stream preview.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 0,
      "minor": 1,
      "patch": 0
    }
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "busId",
      "value": "<replace-with-bus-id>"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"P@ssw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<paste refresh token>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Routes",
      "item": [
        {
          "name": "GET /api/v1/routes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes?limit=10&sort=-updatedAt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "routes"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "-updatedAt"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/routes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RX01\",\n  \"name\": \"Express North\",\n  \"provinceFrom\": \"Northern\",\n  \"provinceTo\": \"Western\",\n  \"distanceKm\": 180\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "routes"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Buses",
      "item": [
        {
          "name": "GET /api/v1/buses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/buses?page=1&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "buses"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/buses/{id}/locations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 6.9271,\n  \"lon\": 79.8612,\n  \"speedKph\": 35\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/buses/{{busId}}/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "buses",
                "{{busId}}",
                "locations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/v1/buses/{id}/locations/latest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('includes next stop and destination ETA when available', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  const estimates = body.data && body.data.estimates;",
                  "  if (!estimates) {",
                  "    pm.expect(estimates).to.eql(null);",
                  "    return;",
                  "  }",
                  "  pm.expect(estimates).to.have.property('nextStop');",
                  "  pm.expect(estimates).to.have.property('destination');",
                  "  pm.expect(estimates.destination).to.have.property('etaMinutes');",
                  "  pm.expect(estimates.delayMinutes).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/buses/{{busId}}/locations/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "buses",
                "{{busId}}",
                "locations",
                "latest"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "GET /api/v1/trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips?filter[serviceDate]=2025-10-06",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trips"
              ],
              "query": [
                {
                  "key": "filter[serviceDate]",
                  "value": "2025-10-06"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "GET /api/v1/alerts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Streaming",
      "item": [
        {
          "name": "GET /stream/positions",
          "request": {
            "method": "GET",
            "description": "Use the Postman console or a browser tab to see the SSE stream.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stream/positions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stream",
                "positions"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
